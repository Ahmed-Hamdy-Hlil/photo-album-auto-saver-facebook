{
  "manifest_version": 3,
  "name": "Facebook Auto Photo Saver",
  "version": "2.1.2",
  "description": "Auto-saves Facebook viewer photos. Enter a count, press Start — it flips and saves them for you. Optionally packs all saved photos into a single ZIP file.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Facebook Auto Photo Saver",
    "default_popup": "popup.html"
  }
}